#! /bin/bash

set -eo pipefail

SCRIPTDIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )

. ~/.bash_aliases
shopt -s expand_aliases

ciao

#
# download data
#

. "$SCRIPTDIR"/../src/functions.bash

mkdir -p data
cd data
for o in $(obsids)
do
    case $o in
	78377 | 78427)
	    continue
	    ;;
	*) ;;
    esac

    files=evt1,bpix,msk,flt,asol,dtf,mtl
    download_chandra_obsid $o $files
done
